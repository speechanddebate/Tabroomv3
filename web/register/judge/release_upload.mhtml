<%args>
	$person
	$tourn
	$judge_id => undef
</%args>
<%init>

	my $judge = Tab::Judge->retrieve($judge_id) if $judge_id;

	unless ($judge && $judge->category && $judge->category->tourn == $tourn->id) {
		$m->comp("/funclib/abort.mas",
			message => "No judge found with ID ".int($judge_id)." in this tournament"
		);
	}

	my $req = Apache2::Request->new($r);

	my $filename = $m->comp("/funclib/judge_release_save.mas",
		judge  => $judge,
		tourn  => $tourn,
		person => $person,
		upload => $req->upload("judge_release_form")
	);

	my $msg = $filename ? "Form uploaded for ".$judge->first." ".$judge->last : "";
	my $err = $filename ? "" : "No valid upload processed";

	$m->redirect("edit.mhtml?judge_id=".$judge->id."&msg=$msg&err=$err");

</%init>
