<%args>
	$person
	$tourn
	$now
	$tourn_settings
	$target_id => undef
	$logtype   => "tabbing"
</%args>
<%init>

	$m->clear_buffer();
	$r->content_type('application/json');

	my $message;

	if ($target_id eq "entry_release") {

		my $filename = $tourn_settings->{"entry_release"};
		system $Tab::s3_cmd." rm ".$Tab::s3_bucket."/tourns/".$tourn->id."/entry_release/".$filename;

		$tourn->setting("entry_release", 0);
		$message = "Entry release form deleted";

	} elsif ($target_id eq "judge_release") {

		my $filename = $tourn_settings->{"judge_release"};
		system $Tab::s3_cmd." rm ".$Tab::s3_bucket."/tourns/".$tourn->id."/judge_release/".$filename;

		$tourn->setting("judge_release", 0);
		$message = "Judge form template deleted";

	} else {

		my $form = Tab::File->retrieve($target_id);

		unless ($form && $form->tourn == $tourn->id && $form->tag eq "school_form") {
			$m->print('{ "error": true, "message": "No school form found for ID '.int($target_id).'"}');
			$m->abort();
		}

		$message = "School form ".$form->label." deleted";

		foreach my $reply ($form->children) {
			system $Tab::s3_cmd." rm ".$Tab::s3_bucket."/tourns/".$tourn->id."/school_form/".$form->id."/".$reply->school."/".$reply->filename;
			$reply->delete;
		}

		system $Tab::s3_cmd." rm ".$Tab::s3_bucket."/tourns/".$tourn->id."/school_form/".$form->id."/".$form->filename;
		$form->delete;
	}

	my $logmsg;
	$logmsg = $message unless $logmsg;

    my %response = (
		error   => 0,
		message => $message
    );

    $m->comp("/funclib/log.mas",
		type        => $logtype,
		tourn       => $tourn->id,
		person      => $person->id,
		description => $logmsg
	);

    $m->print(JSON::encode_json(\%response));
	$m->abort();

</%init>
