<%args>
	$person
	$tourn
	$label              => undef
	$new_form           => undef
	$entry_release_form => undef
	$judge_release_form => undef
</%args>
<%init>

	my $msg;

	if ($new_form) {

		my $req = Apache2::Request->new($r);
		my $upload = $req->upload("new_form");
		my $filename  = $upload->filename;

		$filename =~ s/[^\w.]//g;
		$filename =~ s/\.(?=.*\.)//g;

		$label = $filename unless $filename;
		$filename =~ s/\s//g;

		my $filetemp = $upload->tempname;

		my $form;

		if ($filetemp) {
			$form = Tab::File->create({
				tourn    => $tourn->id,
				tag      => "school_form",
				label    => $label,
				filename => $filename,
			});
		}

		my $success = $m->comp("/funclib/s3_put.mas",
			source => $filetemp,
			key    => "tourns/".$tourn->id."/school_form/".$form->id."/".$filename
		);

		unless ($form && $success) {
			$form->delete if $form;
			$m->comp("/funclib/abort.mas",
				message => "Tabroom could not save the file ".$filename." to file storage, so it was not uploaded. Please try again."
			);
		}

		$msg = "Form ".$form->label." $filename created for schools to download &amp; re-upload";

	} elsif ($entry_release_form) {

		my $req = Apache2::Request->new($r);
		my $upload = $req->upload("entry_release_form");
		my $filename  = $upload->filename;

		$filename =~ s/[^\w.]//g;
		$filename =~ s/\.(?=.*\.)//g;

		$label = $filename unless $filename;
		$filename =~ s/\s//g;

		my $filetemp = $upload->tempname;

		my $success = $m->comp("/funclib/s3_put.mas",
			source => $filetemp,
			key    => "tourns/".$tourn->id."/entry_release/".$filename
		);

		unless ($success) {
			$m->comp("/funclib/abort.mas",
				message => "Tabroom could not save the file ".$filename." to file storage, so it was not uploaded. Please try again."
			);
		}

		$tourn->setting("entry_release", $filename);
		$msg = "Entry release form template $filename has been uploaded";

	} elsif ($judge_release_form) {

		my $req = Apache2::Request->new($r);
		my $upload = $req->upload("judge_release_form");
		my $filename  = $upload->filename;

		$filename =~ s/[^\w.]//g;
		$filename =~ s/\.(?=.*\.)//g;
		$filename =~ s/\s//g;
		$filename = substr($filename, 0, 120);

		my $filetemp = $upload->tempname;

		if ($filename && $filetemp) {

			my $success = $m->comp("/funclib/s3_put.mas",
				source => $filetemp,
				key    => "tourns/".$tourn->id."/judge_release/".$filename
			);

			unless ($success) {
				$m->comp("/funclib/abort.mas",
					message => "Tabroom could not save the file ".$filename." to file storage, so it was not uploaded. Please try again."
				);
			}

			$tourn->setting("judge_release", $filename);
			$msg = "Judge form template $filename has been uploaded";
		}
	}

	# Da fuq even is this?
	# $tourn->setting("instructions_url", "text", $ARGS{"instructions_url"});

	$m->comp('/funclib/log.mas',
		person      => $person,
		tag         => "registration",
		tourn       => $tourn,
		description => $msg
	);

	$m->redirect("messages.mhtml?msg=$msg");

</%init>
