<%args>
	$webname => undef
</%args>
<%init>

	my @array = eval {
		return @{$webname};
	};

	if (@array) {
		$webname = $array[0];
	}

	my @tourns = Tab::Tourn->search( webname => $webname);

</%init>

	<div class="main">

		<div class="flexrow">
			<span class="threequarters nospace padleft">
				<h4>
					<% $webname %> Tournaments
				</h4>
			</span>
			<span
				class ="quarter rightalign padright"
				id    ="past_tourns_buttonarea"
			>
			</span>
		</div>

		<& /funclib/tablesorter.mas, table => "past_tourns" &>

		<table id="past_tourns">

			<thead>
				<tr class="yellowrow smallish">
					<th>
						Year
					</th>

					<th>
						Name
					</th>

					<th>
						Start
					</th>

					<th>
						End
					</th>
				</tr>
			</thead>

			<tbody>

%				foreach my $tourn (sort {$b->start <=> $a->start} @tourns) {

					<tr>

						<td>
							<% $tourn->start->year %>
						</td>

						<td>
							<a class="white" href="main.mhtml?tourn_id=<% $tourn->id %>">
								<% $tourn->name %>
							</a>
						</td>

						<td>
							<% Tab::pickerdate($tourn->start)%>
						</td>

						<td>
							<% Tab::pickerdate($tourn->end)%>
						</td>

					</tr>
%				}

			</tbody>

		</table>

	</div>


