<%args>
	$judge
	$tourn
	$person
	$upload   => undef
	$deadline => undef
</%args>
<%init>

	return unless $upload && $upload->filename;

	unless ($tourn->setting("judge_release")) {
		$m->comp("/funclib/abort.mas",
			message => $tourn->name." does not ask judges for a form"
		);
	}

	if ($deadline) {
		my $release_deadline = $tourn->setting("release_deadline")
			|| $tourn->setting("drop_deadline")
			|| $tourn->reg_end;

		if ($release_deadline && DateTime->now() > $release_deadline) {
			$m->comp("/funclib/abort.mas",
				warning => "The deadline for judge form uploads has passed"
			);
		}
	}

	my $filename = $m->comp("/funclib/upload_test.mas", upload => $upload);
	return unless $filename;

	my $filetemp = $upload->tempname;
	my $existing = $judge->setting("judge_release");
	my $description;

	my $success = $m->comp("/funclib/s3_put.mas",
		source => $filetemp,
		key    => "tourns/".$tourn->id."/judge_release/".$judge->id."/".$filename
	);

	if ($success) {

		$description = "Judge form ".$filename." uploaded for judge ".$judge->first." ".$judge->last;

		if ($existing && $existing ne $filename) {
			system $Tab::s3_cmd." rm ".$Tab::s3_bucket."/tourns/".$tourn->id."/judge_release/".$judge->id."/".$existing;
			$description = "Judge form ".$filename." replaced $existing for judge ".$judge->first." ".$judge->last;
		}

		$judge->setting("judge_release", $filename);
		$judge->setting("judge_release_at", "date", DateTime->now());
		$judge->setting("judge_release_by", $person->id);

	} else {
		$m->comp("/funclib/abort.mas",
			message => "Tabroom could not save the file ".$filename." to file storage, so it was not uploaded. Please try again."
		);
	}

	$m->comp("/funclib/log.mas",
		tag         => "registration",
		tourn       => $tourn->id,
		judge       => $judge->id,
		person      => $person->id,
		description => $description,
	);

	return $filename;

</%init>
