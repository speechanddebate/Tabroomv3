<%args>
	$person
</%args>
<%init>

	unless ($person->nsda > 0) {
		return;
	}

	# Check to make sure I have access to any schools I am the advisor for.
	my $dbh = Tab::DBI->db_Main();

	my ($roles_ref, $roles_json) = $m->comp(
		"/funclib/nsda/api_client.mas",
		path => "/members/".$person->nsda."/roles"
	);

	my $already_sth = $dbh->prepare("
		select chapter.id, chapter.nsda
			from chapter, permission
		where permission.person = ?
			and permission.tag = 'chapter'
			and permission.chapter = chapter.id
			and chapter.nsda > 0
	");

	$already_sth->execute($person->id);

	my $already_ref = $already_sth->fetchall_hash();
	my %already = map {$_->{nsda} => $_->{id}} @{$already_ref};

	my $now = DateTime->now();
	my $string = DateTime::Format::MySQL->format_datetime($now);
	$string =~ s/[\D_]//g;

	Tab::debuglog("I am called with roles ref $roles_ref which number ".scalar @{$roles_ref});

	if ($roles_ref && @{$roles_ref}) {

		my $new_counter;
		my @new_roles;

		foreach my $role (@{$roles_ref}) {
			next if $role->{role} ne "Advisor";
			next if $already{$role->{school_id}};

			my $time = $role->{end};
			if ($time) {
				$time =~ s/[\D_]//g;
				if ($time < $string) {
					next;
				}
			}
			$new_counter++;
			push @new_roles, $role;
		}

		if (scalar @new_roles > 10) {

			my $description = $person->email." ".$person->nsda." was DENIED automatic access because they have ";
			$description = scalar @new_roles." inactive roles in the NSDA over the 10 limit.";

			Tab::ChangeLog->create({
				tag         => "account",
				chapter     => $chapter->{id},
				person      => $person->id,
				description => $description
			});

			my $message = $m->comp("/funclib/send_notify.mas",
				from_string => "Tabroom Excessive Account Access <littlesnitch\@www.tabroom.com>",
				ids         => [1, 3, 25656],
				subject     => "Too Many Roles Pending",
				html        => "<p>".$description."</p>";
			);

			return;
		}

		foreach my $role (@new_roles) {

			$already_sth->execute($role->{school_id}, $person->id);
			my $chapters = $already_sth->fetchall_hash();

			if ($chapters && @{$chapters}) {
				foreach my $chapter (@{$chapters}) {
					my $perm = eval {
						return Tab::Permission->create({
							person  => $person->id,
							tag     => "chapter",
							chapter => $chapter->{id}
						});
					};

					if ($perm) {
						Tab::ChangeLog->create({
							tag         => "chapter",
							chapter     => $chapter->{id},
							person      => $person->id,
							description => $person->email." ".$person->nsda." was given automatic access because they are an NSDA advisor to school ID ".$role->{school_id}." end date ".$role->{end},
						});
					}
				}
			}
		}
	}
</%init>
