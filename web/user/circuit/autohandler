<%args>
	$person
	$perms
	$circuit_id     => undef
	$sweep_set_id   => undef
	$sweep_award_id => undef
</%args>
<%init>

	my $sweep_award = Tab::SweepAward->retrieve($sweep_award_id) if $sweep_award_id;
	my $sweep_set = Tab::SweepSet->retrieve($sweep_set_id) if $sweep_set_id;
	my $circuit = Tab::Circuit->retrieve($circuit_id) if $circuit_id;

	if ($sweep_set) {
		$sweep_award = $sweep_set->sweep_award;
	}

	if ($sweep_award) {
		$circuit = $sweep_award->circuit;
	}

	if ($circuit) {

		my $tourn;
		my $chapter;

		if ($ARGS{tourn_id}) {

			$tourn = Tab::Tourn->retrieve($ARGS{tourn_id});
			unless ($tourn) {
				$m->comp("/funclib/abort.mas", message => "No valid tournament found with that ID");
			}

			unless (Tab::TournCircuit->search(
				circuit => $circuit->id,
				tourn   => $tourn->id
			)) {
				$m->comp("/funclib/abort.mas", message => "That tournament is not a member of that circuit.");
			}
		}

		if ($ARGS{chapter_id}) {

			$chapter = Tab::Chapter->retrieve($ARGS{chapter_id});
			unless ($chapter) {
				$m->comp("/funclib/abort.mas", message => "No valid institution found with that ID");
			}

			unless (Tab::ChapterCircuit->search(
				chapter => $chapter->id,
				circuit => $circuit->id
			)) {
				$m->comp("/funclib/abort.mas", message => "That chapter is not a member of that circuit.");
			}
		}

		unless ($person->site_admin || $perms->{'circuit'}{$circuit_id}) {
			$m->comp("/funclib/abort.mas", message => "You do not to have access to alter that circuit.");
			$m->abort();
		}

		$m->call_next(
			circuit     => $circuit,
			chapter     => $chapter,
			tourn       => $tourn,
			sweep_award => $sweep_award,
			sweep_set   => $sweep_set,
			person      => $person
		);

	} else {

		$m->comp("/funclib/abort.mas", message => "You sent an request without a circuit ID");
		$m->abort();

	}

</%init>

