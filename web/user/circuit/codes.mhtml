<%args>
	$circuit
</%args>
<%init>

	my @chapters = $m->comp("/funclib/circuit_chapters.mas", circuit => $circuit);
	my %used = ();

</%init>

	<& menu.mas, circuit => $circuit, whoami => "codes" &>

	<div class="main">

		<div class='flexrow full'>
			<span class="threequarters nospace">
				<h4>Standard school codes</h4>
			</span>
			<span
				class="quarter rightalign nospace"
				id ="circuit_codes_buttonarea"
			>
			</span>
		</div>

		<& /funclib/tablesorter.mas, table => "circuit_codes" &>

		<form action="codes_save.mhtml" method="post">
		<input type="hidden" name="circuit_id" value="<% $circuit->id %>">

		<table id="circuit_codes">
			<thead>
				<tr class="yellowrow">
					<th>
						School
					</th>

					<th>
						Code
					</th>
				</tr>
			</thead>

			<tbody>

%				foreach my $chapter (@chapters) {

%					next if $used{$chapter->id};
%					$used{$chapter->id}++;

					<tr>

						<td>
							<% $chapter->name %>
						</td>

						<td class="centeralign">
							<input
								type      ="text"
								size      ="10"
								maxlength ="10"
								name      ="<% $chapter->id %>"
								value     ="<% $chapter->code %>"
							>
						</td>

					</tr>

%				}

			</tbody>
			<tr class="liblrow">
				<td class="rightalign" colspan="2">
					<input type="submit" value="Save Codes">
					</form>
				</td>
			</tr>
		</table>
	</div>


