<%args>
	$circuit
	$tourn_id
	$admin_id
	$tag
	$inactive => undef
</%args>
<%init>

	return unless $admin_id;

	my $admin = Tab::Person->retrieve($admin_id);
	return unless $admin;

	my $tourn = Tab::Tourn->retrieve($tourn_id);
	return unless $tourn;

	my $already = Tab::Permission->search(
		tourn  => $tourn->id,
		person => $admin->id,
		tag    => $tag
	);

	if ($already) {

		$already->delete if $inactive;

	} elsif (not defined $inactive) {

		Tab::Permission->create({
			tourn  => $tourn->id,
			person => $admin->id,
			tag    => $tag
		});

	}

	my $msg = "Permissions for ".$admin->email." change to $tag by circuit admin ".$person->email;

	Tab::ChangeLog->create({
		tag         => "tabbing",
		tourn       => $tourn_id,
		person      => $person,
		description => $msg
	});

	return;

</%init>

