<%args>
	$person
	$name      => undef
	$country   => undef
	$level     => undef
	$state     => undef
	$duplicate => undef
	$naudl     => undef
	$nces      => undef
	$ipeds     => undef
	$ceeb      => undef
	$search    => undef
	$street    => undef
	$zip       => undef
	$postal    => undef
</%args>
<%init>

	my @chapters;

	if ($search) {

		my $search_name = $name;
		$search_name = $m->comp('/funclib/short_name.mas', name => $search_name);

    	$search_name =~ s/^\s+//;  #leading spaces
    	$search_name =~ s/\s+$//;  #trailing spaces

		#this is friggin annoying
	    $search_name =~ s/of Math and Science$//g;
    	$search_name =~ s/Academy$//g;
    	$search_name =~ s/Regional\ High\ School$//g;
    	$search_name =~ s/High\ School$//g;
   		$search_name =~ s/School$//g;
    	$search_name =~ s/High$//g;
    	$search_name =~ s/Preparatory$/Prep/g;
    	$search_name =~ s/College\ Prep$/CP/g;
    	$search_name =~ s/HS$//g;
    	$search_name =~ s/Regional$//g;
    	$search_name =~ s/Public\ Charter//g;
    	$search_name =~ s/Charter\ Public//g;
    	$search_name =~ s/^The//g;
    	$search_name =~ s/^Saint/St./g;
    	$search_name = "College Prep" if $search_name eq "CP";  #Sometimes it's the whole school name.  Oops.
    	$search_name =~ s/High\ School/HS/g;

		unless ($duplicate) {
			@chapters = Tab::Chapter->search_where(
				name    => { "like", $name."%"},
				country => $country,
				state   => $state );

			push @chapters, Tab::Chapter->search_where(
				name    => { "like", $search_name."%"},
				country => $country,
				state   => $state );
		}
	}

</%init>

	<div class="main">


%		if (@chapters) {

			<h5 class="semibold">That institution might already exist in Tabroom!</h5>

			<div class="flexrow centeralign">

				<span class="ninetenths leftalign">
					<p>
						An institution already exists with that name &amp;
						location.  If you are a new coach for an existing
						program, you should instead email the previous coaches
						to request access to that program's account, so you can
						gain access to the existing team history &amp; records.
					</p>

					<p>
						To gain access to an account where the coaches with
						access cannot be reached, please contact <a href="mailto:
						help@tabroom.com">help@tabroom.com</a>
					</p>

					<p>
						However, if you are creating a parallel program, or if
						there are just two institutions with the same name or
						something, click "confirm dupilication" below.
					</p>
				</span>
			</div>

			<div class="yellow flexrow">
				<span class="half semibold">
					Name
				</span>

				<span class="half semibold">
					Accounts w/access
				</span>
			</div>

%			my %used;
%			foreach my $chapter (@chapters) {
%				next if $used{$chapter->id}++;

				<div class="row flexrow">

					<span class="half padleft">
						<% $chapter->name %>
					</span>

					<span class="half padvert padleft">
						<& "/funclib/chapter_admins.mas", chapter => $chapter, print => 1 &>
					</span>

				</div>

% 			}


			<br />

			<h4>
				Or, change names or confirm that this is a new school:
			</h4>

% 		} else {

			<h2>Create a new school/team</h2>
% 		}

			<form
				action ="save.mhtml"
				method ="post"
			>

			<input
				type  ="hidden"
				name  ="new"
				value ="yessireebob"
			>

			<div class="row flexrow">
				<span class="half padleft">
					Institution/School/Team Name
				</span>

				<span class="half padright">
					<input
						type  = "text"
						name  = "chapter_name"
						value = "<% $name %>">
				</span>
			</div>

			<div class="row flexrow">
				<span class="half padleft">
					Level
				</span>

				<span class="half padright">
					<select name="level">
						<option value="">--Please choose a level--</option>

						<option <% $level eq "university" ? 'selected' : "" %>
							value="university">College/University</option>

						<option <% $level eq "highschool" ? 'selected' : "" %>
							value="highschool">High School/Secondary</option>

						<option <% $level eq "middle" ? 'selected' : "" %>
							value="middle">Middle/Junior High</option>

						<option <% $level eq "elementary" ? 'selected' : "" %>
							value="elementary">Elementary</option>

						<option <% $level eq "independent" ? 'selected' : "" %>
							value="independent">Independent Entry</option>

						<option <% $level eq "private" ? 'selected' : "" %>
							value="private">Private/For Profit</option>

						<option <% $level eq "homeschool" ? 'selected' : "" %>
							value="homeschool">Home School</option>

					</select>
				</span>

			</div>

			<div class="row flexrow">

				<span class="half padleft">
					Street
				</span>

				<span class="half padright">
					<input
						type  = "text"
						name  = "street"
						value = "<% $name %>">
				</span>

			</div>

			<div class="row flexrow">

				<span class="half padleft">
					City
				</span>

				<span class="half padright">
					<input
						type  = "text"
						name  = "city"
						value = "<% $name %>">
				</span>

			</div>

			<div class="row flexrow">

				<span class="half padleft">
					State/Province (if applicable)
				</span>

				<span class="half padright">
					<select name="state">
						<& "/funclib/state_select.mas", state => $state &>
					</select>
				</span>

			</div>

			<div class="row flexrow">

				<span class="half padleft">
					US Zip
				</span>

				<span class="half padright">
					<input
						type  = "number"
						name  = "zip"
						min   = "01000"
						max   = "99999"
						value = "<% $zip %>">
				</span>

			</div>

			<div class="row flexrow">

				<span class="half padleft">
					Postal Code (Non-USA)
				</span>

				<span class="half padright">
					<input
						type  = "text"
						name  = "postal"
						value = "<% $postal %>">
				</span>

			</div>


			<div class="row flexrow">

				<span class="half padleft">
					Country
				</span>

				<span class="half padright">
					<select name="country">
						<& "/funclib/country_select.mas", country => $country &>
					</select>
				</span>

			</div>

			<div class="row flexrow">

				<span class="fourfifths padleft">
					Is your school a member of a Urban Debate League
					affiliated with NAUDL?
				</span>

				<span class="hover fifth centeralign">
					<label for="naudl" class="centeralign">
						<input
							type  = "checkbox"
							id    = "naudl"
							name  = "naudl"
							value = "1"
							<% $naudl ? 'checked="checked"' : "" %>>
					</label>
				</span>

			</div>

			<h5>The following optional information helps us prevent duplicate records</h5>

			<div class="row flexrow">

				<span class="twothirds padleft">
					National Center for Education Statistics number
				</span>

				<span class="third padright">
					<input
						type  = "text"
						name  = "nces"
						value = "<% $nces %>">
				</span>

			</div>

			<div class="row flexrow">

				<span class="twothirds padleft">
					CEEB (College Entrance Examination Board) number
				</span>

				<span class="third padright">
					<input
						type  = "text"
						name  = "ceeb"
						value = "<% $ceeb %>">
				</span>

			</div>

			<div class="row flexrow">

				<span class="twothirds padleft">
					IPEDS Number (US College/Universities)
				</span>

				<span class="third padright">
					<input
						type  = "text"
						name  = "ipeds"
						value = "<% $ipeds %>">
				</span>

			</div>

%			if (@chapters) {

				<label for="dupe">
					<div class="row flexrow hover martopmore bluebordertop">
						<span class="half padsetting semibold redtext">
							You confirm this is not a duplicate program:
						</span>
						<span class="half centeralign">
							<input
								type  = "checkbox"
								name  = "duplicate"
								value = "1"
								id    = "dupe"
							>
						</span>
					</div>
				</label>

%			}

		<div class="libl row flexrow rightalign padvert padrightmore">
			<span class="centeralign third">
				<input
					type  = "submit"
					value = "Save School Info"
				>
			</span>
		</div>

		</form>

	</div>

	<&
		"/user/menu.mas",
		person => $person
	&>

