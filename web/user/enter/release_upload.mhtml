<%args>
	$person
	$tourn
	$school_id  => undef
	$student_id => undef
	$label      => undef
</%args>
<%init>

	my $msg;
	my $err;

	my $school = Tab::School->retrieve($school_id);
	my $student = Tab::Student->retrieve($student_id);

	my $req = Apache2::Request->new($r);
	my $upload = $req->upload("release_form");

    my %release_forms = eval {
        return %{JSON::decode_json($school->setting("release_forms"))};
    };

	if ($upload) {

		my $filename = $m->comp("/funclib/upload_test.mas", upload => $upload);
		my $filetemp = $upload->tempname;

		my $success = $m->comp("/funclib/s3_put.mas",
			source => $filetemp,
			key    => "tourns/".$tourn->id."/".$folder."/".$school->id."/".$student->id."/".$filename
		);

		if ($success) {
			$release_forms{$student->id} = $filename;
			$msg .= "<br />" if $msg;
			$msg .= $student->first." ".$student->last."'s forms are uploaded: $reply";

			$m->comp("/funclib/log.mas",
				tag         => "registration",
				person      => $person->id,
				tourn       => $tourn->id,
				school      => $school->id,
				description => ucfirst($type)." form reply $filename has been uploaded for student ".$student->first." ".$student->last,
			);

		} else {
			$err .= "<br />" if $err;
			$err .= "Tabroom could not save the file ".$filename." to file storage, so it was not uploaded. Please try again.";
		}
	}

	$school->setting(
		"release_forms",
		"text",
		JSON::encode_json(\%release_forms)
	);

	$err = $err || $msg || "No valid upload processed";
	$m->redirect("by_person_edit.mhtml?school_id=".$school->id."&student_id=".$student->id."&err=$err&msg=$msg");

</%init>
