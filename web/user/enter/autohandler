<%args>
	$dbh
	$person
	$person_settings
	$perms
	$tourn_id   => undef
	$entry_id   => undef
	$judge_id   => undef
	$school_id  => undef
	$chapter_id => undef
</%args>
<%init>

	# These functions self display based on the person record inbound from the
	# session.

	if (
		$r->uri eq "/user/enter/strike_cards.mhtml"
		|| $r->uri eq "/user/enter/strike_card_save.mhtml"
		|| $r->uri eq "/user/enter/flip.mhtml"
		|| $r->uri eq "/user/enter/flip_monitor.mhtml"
		|| $r->uri eq "/user/enter/flip_save.mhtml"
	) {
		$m->call_next();
		return;
	}

	my $school;
	my $status;

	# In order from most particular to least.

	#Entry Based Permissions
	if ($entry_id) {

		my $sth = $dbh->prepare("
			select
				entry.id entry,
				(select student.id
					from student, entry_student es
					where student.person = ?
					and student.id = es.student
					and es.entry = entry.id
				) as student_id,
				school.id school_id,
				(select chapter.id
					from chapter
					where chapter.id = school.chapter
				) as chapter_id,
				(select sp.value
					from chapter_setting sp
					where sp.chapter = school.chapter
					and sp.tag = 'self_prefs'
				) as self_prefs

			from entry, school
			where entry.id = ?
				and entry.school = school.id
		");

		$sth->execute($person->id, $entry_id);
		my $results = $sth->fetchall_hash();

		my $ref = eval { return shift @{$results}; };

		if ($ref) {

			if ($person->site_admin > 0) {
				$school = Tab::School->retrieve($ref->{school_id});
				$m->call_next(school => $school, tourn => $school->tourn);
				return;
			}

			# If I have blanket chapter permissions I get the keys
			if (
				$ref->{chapter_id} > 0
				&& $perms->{chapter}{$ref->{chapter_id}} eq "chapter"
			) {
				$school = Tab::School->retrieve($ref->{school_id});
				$m->call_next(school => $school, tourn => $school->tourn);
				return;
			}

			# If I have prefs only permissions, and these are ratings, go for it.
			if (
				$ref->{chapter_id} > 0
				&& $perms->{chapter}{$ref->{chapter_id}} eq "prefs"
				&& $r->uri =~ /user\/enter\/ratings\//
			) {
				$school = Tab::School->retrieve($ref->{school_id});
				$m->call_next(school => $school, prefs => 1);
				return;
			}

			# If I am one of the students and self_prefs are enabled and these are
			# prefs, go for it.

			if ($ref
				&& $ref->{student_id}
				&& $ref->{self_prefs}
				&& $r->uri =~ /user\/enter\/ratings\//
			) {
				$school = Tab::School->retrieve($ref->{school_id});
				$m->call_next(school => $school, tourn => $school->tourn, prefs => 1, no_others => 1);
				return;
			}

		}
	}

	# School based permissions
	if ($school_id) {

		my $school = Tab::School->retrieve($school_id);

		if ($school) {

			if ($person->site_admin > 0) {
				$m->call_next(school => $school, tourn => $school->tourn);
				return;
			}

			# If I have blanket chapter permissions I get the keys
			if (
				$school->chapter > 0
				&& $perms->{chapter}{$school->chapter} eq "chapter"
			) {
				$m->call_next(school => $school, tourn => $school->tourn);
				return;
			}

			my $up;

			if ($r->uri =~ /user\/enter\/ratings\//) {
				$up++;
			}

			# If I have prefs only permissions, and these are ratings, go for it.
			if (
				$school->chapter > 0
				&& $perms->{chapter}{$school->chapter} eq "prefs"
				&& $r->uri =~ /user\/enter\/ratings\//
			) {
				$m->call_next(school => $school, prefs => 1);
				return;
			}
		}
	}

	#Chapter Based Permissions
	if ($chapter_id > 0) {

		my $chapter = Tab::Chapter->retrieve($chapter_id);

		if ($tourn_id > 0) {
			$school = Tab::School->search(
				tourn => $tourn_id,
				chapter => $chapter_id
			)->first;
		}

		if ($school) {

			if ($person->site_admin > 0) {
				$m->call_next(school => $school, tourn => $school->tourn);
				return;
			}

			# If I have blanket chapter permissions I get the keys
			if (
				$school->chapter > 0
				&& $perms->{chapter}{$school->chapter} eq "chapter"
			) {
				$m->call_next(school => $school, tourn => $school->tourn);
				return;
			}

		} elsif ($r->uri eq "/user/enter/create.mhtml" || $r->uri eq "/user/enter/nsda_roster_check.mhtml") {
			$m->call_next(chapter => $chapter);
			return;
		}
	}

	# Coach contacts get dashboard permissions
	if ($school_id && $r->uri eq "/user/enter/dashboard.mhtml") {
		my $sth = $dbh->prepare("
			select
				contact.id
			from contact
			where contact.person = ?
			and contact.school = ?
		");

		$sth->execute($person->id, $school_id);

		my $refs = $sth->fetchall_hash();
		my $ref = eval { return shift @{$refs}; };

		if ($ref->{id}) {
			$school = Tab::School->retrieve($school_id);
			$m->call_next(school => $school, tourn => $school->tourn);
			return;
		}
	}

	$m->redirect("/user/home.mhtml?err=You are not authorized to access that school");

</%init>
