<%args>
	$dbh
	$now
	$person
	$person_settings
	$school
	$category_id => undef
	$entry_id    => undef
	$prefs       => undef
</%args>
<%init>

	use POSIX;

	Tab::Judge->columns(TEMP => "short_name");

	my $tourn = $school->tourn;
	my %ratings_by_judge = ();
	my %conflicts_by_id = ();

	my $entry = Tab::Entry->retrieve($entry_id) if $entry_id;

	my @judges;
	my $event = $entry->event;
	my $chapter_id = $school->chapter->id;

	my $category = eval {
		if ($category_id) {
			return Tab::Category->retrieve($category_id);
		} elsif ($event) {
			return $event->category;
		}
	};

	my %category_settings = $category->all_settings;
	my $rounds_per = $category_settings{"rounds_per"};

	my $no_others++;

	if ($person) {
		undef $no_others if $person->site_admin;
		foreach my $admin ($school->chapter->admins) {
			undef $no_others if $admin->id == $person->id;
		}
	}

	if ($entry->event->setting("no_prefs")) {
		$m->comp("/funclib/abort.mas", message => "No prefs are offered in this division");
	}

	my $strike_end = $category_settings{"strike_end"};
	my $read_only++ if $strike_end < $now;

	my $strike_start = $category_settings{"strike_start"};
	$read_only++ if $strike_start > $now;

	my $switch;
    my %rating_name = ();
    foreach my $tier ($category->rating_tiers) {
        $rating_name{$tier->id} = $tier->name;
    }

	my $coach_ratings = $category_settings{"coach_ratings"};
    my %coach_rating_by_judge = ();

    foreach my $rating (
		$m->comp(
			"/funclib/category_ratings.mas",
			category => $category,
			type     => "coach"
		)
	) {

		next unless $rating->rating_tier;
        $coach_rating_by_judge{$rating->judge->id} = $rating_name{$rating->rating_tier->id};
    }

	undef($read_only) if $entry->setting("open_prefs");

	if ($read_only) {

		my $msg = "Prefs can no longer be edited; the deadline has passed";
		$m->redirect("ordinals_prefs.mhtml?entry_id=$entry_id&msg=$msg#");
	}

	my %freebie = $m->comp("/funclib/free_strikes.mas", category => $category);

	my %neutrals =
		map {$_->judge->id => 1}
		$m->comp(
			"/funclib/category_judge_settings.mas",
			category => $category,
			tag => "neutral"
		)
	if $category_settings{"neutrals"};

</%init>

	<div class="main">

%		unless ($prefs) {
			<& /user/enter/tabbar.mas,
				school => $school,
				whoami => "ratings"
			&>
%		}

		<& "paradigm_check.mas",
			school   => $school,
			category => $category
		&>

%		unless ($entry) {

			<h3>Judge Ratings in <% $category->name %> </h3>
			<p>Choose an entry at right to continue</p>
<%perl>
		} else {

			@judges = $m->comp("judges.mas", category => $category, active => 1);
			@judges = sort {$a->last cmp $b->last} @judges;
			@judges = sort {$a->short_name cmp $b->short_name} @judges;

			foreach my $conflict ($entry->strikes( registrant => 1, conflict => 1)) {
				$conflicts_by_id{$conflict->judge->id} = $conflict;
			}

			foreach my $conflict ($entry->school->strikes( registrant => 1, conflict => 1)) {
				$conflicts_by_id{$conflict->judge->id} = $conflict;
			}

			my %event_struck =
				map {$_->judge->id => 1}
				Tab::Strike->search(type => "event", event => $entry->event->id);

			my %ordinal_by_judge = ();

			my @ratings = Tab::Rating->search( entry => $entry->id, type => "entry");

			foreach my $rating (@ratings) {
				$ratings_by_judge{$rating->judge->id} = $rating;
				$ordinal_by_judge{$rating->judge->id} = $rating->ordinal if $rating;
			}

			@judges = sort { $ordinal_by_judge{$a->id} <=> $ordinal_by_judge{$b->id} } @judges;

</%perl>
			<script>
				$(function(prefs) {

					$( "#prefsort" ).disableSelection();

					$( "#prefsort" ).sortable({
						connectWith      : "ul",
						scroll           : "true",
						disableSelection : "true",
						opacity          : 0.6,
						revert           : "true",
						placeholder      : "ui-state-highlight",
						axis             : "y",
						update			: function(event, ui) {
							$('#sortorder').val($(this).sortable('serialize'));
						},
						stop             : function(event, ui) {
							ui.item.removeClass("ui-state-default");
							ui.item.toggleClass("ui-state-changed");
							$('#subme').removeClass("hidden");
							$('#submoi').removeClass("hidden");
						}
					});

					return false;
				});

			</script>

			<div>
				<span class="threequarters">
					<h4>Rate <% $category->abbr %> Judges for <% $entry->name %></h4>
				</span>

				<span class="quarter rightalign">
					<a
						class="ltbuttonwhite bluetext centeralign"
						href="ordinals_prefs.mhtml?entry_id=<% $entry_id %>#yo">
						Numeric Entry
					</a>
				</span>
			</div>

%			if (%freebie) {
				<p class="semibold greentext biggish nospace centeralign padvert">
					Judges marked in green are free strikes; they do not count against rating quotas.
				</p>
%			}

			<form action="ordinals_sort_save.mhtml" method="post">

				<input
					type  = "hidden"
					name  = "entry_id"
					value = "<% $entry->id %>"
				>

				<input
					type  = "hidden"
					name  = "school_id"
					value = "<% $school->id %>"
				>

				<input
					type = "hidden"
					name = "sortorder"
					id   = "sortorder"
				>

			<div class="ltborder padtop">

				<ul
					id    = "prefsort"
					class = "prefs centeralign"
					style = "margin: auto;"
				>
<%perl>
					foreach my $judge (@judges) {

						next if ($judge->school && $judge->school->id == $school->id)
						&& (not defined $neutrals{$judge->id});

						next if $conflicts_by_id{$judge->id};
						next if $event_struck{$judge->id};
</%perl>
						<li class = "leftalign ltyellowhover flexrow ui-state-default border full semibold <% $freebie{$judge->id} ? "greentext greenborder" : "" %>"
							id    = "judge_<% $judge->id %>"
							style = "font-size: 105%;"
						>
							<span class="twenty marno">
								<%  $ordinal_by_judge{$judge->id} ? $ordinal_by_judge{$judge->id} : "0" %>
							</span>

							<span class="quarter marno nowrap">
								<% $judge->first." ".$judge->last %>
							</span>

							<span class="tenth marno">
%								if ($coach_ratings) {
									<% $coach_rating_by_judge{$judge->id} %>
%								}
								<% $freebie{$judge->id} ? "FREE" : "" %>
							</span>

							<span class="twofifths marno nowrap">
								<% ($judge->school && $judge->school->id)
									? $judge->school->short_name.", ".$judge->school->chapter->state
									: "Unaffilated "%>
							</span>

%							if ($rounds_per) {
								<span class="tenth marno padleft">
									<% ($judge->obligation + $judge->hired) ? ($judge->obligation + $judge->hired) : "0" %> rds
								</span>
%							}
						</li>
%					}
				</ul>

			</div>

			<div class="libl full rightalign hidden" id="submoi">
				<span class="third centeralign">
					<input
						type  = "submit"
						value = " Save Prefs Order "
					>
				</span>
			</div>
%		}

	</div>

    <div class="menu">

%		if ($entry && $read_only < 1) {

			<div class="sidenote">

				<div class="block centeralign">
					<input
						type  = "submit"
						value = "Save Pref Sheet"
						class = "full">
					</form>
				</div>

				<h4>Dolly the Sheep</h4>
<%perl>
				my $warn = "You are about to WIPE any existing prefs and
				calculate them based on previous rankings.  OK continues and
				Cancel goes back";
</%perl>
				<a
					class="yellow full"
					href="export_prefs.mhtml?entry_id=<% $entry->id %>&school_id=<% $school->id %>"
				>
					Export Prefs to Excel
				</a>

%				unless ($read_only) {
					<a class="yellow full"
						href="ordinals_auto_pref.mhtml?school_id=<% $school->id %>&entry_id=<% $entry->id %>"
						<& "/funclib/confirm.mas", warn => $warn &>
					>
						Fill in based on our pref sheets
					</a>

					<p>Fill in based on prefs by:</p>

					<div class="even full">

						<form action="ordinals_auto_pref.mhtml" method="post">

						<div class="full flexrow nospace">

						<input
							type  = "hidden"
							name  = "entry_id"
							value = "<% $entry->id %>"
						>

						<input
							type  = "hidden"
							name  = "school_id"
							value = "<% $school->id %>"
						>

						<span class="grow padleft padright">

						<select name="student_id">
<%perl>
							my $fill_in_sth = $dbh->prepare("

								select
									student.id, student.first, student.last,
										chapter.name,
										chapter.id chapter_id,
									(select e2.code
										from entry e2, event
										where 1=1
										and e2.active   = 1
										and e2.event    = entry.event
										and e2.id      != entry.id
										and exists (select es2.id
											from entry_student es2
											where es2.student = student.id
											and es2.entry = e2.id
										)
										group by e2.id
									) as entry

								from student, chapter, entry_student es, entry, student ess
								where student.retired = 0
									and student.chapter = chapter.id
									and es.entry = ?
									and es.entry = entry.id
									and entry.active = 1
									and es.student = ess.id
									and chapter.id = ess.chapter

								group by student.id
								order by entry DESC, chapter.name, student.last
							");

							$fill_in_sth->execute($entry->id);
							my $others = $fill_in_sth->fetchall_hash();
							my %used;

							foreach my $student ($entry->students) {
								next if $used{$student->id}++;
</%perl>
								<option
									value="<% $student->id %>"
								><% $student->last.", ".$student->first %></option>
<%perl>
							}

							foreach my $student (@{$others}) {

								next if $used{$student->{id}}++;
</%perl>
								<option
									value="<% $student->{id} %>"
								>
									<% $student->{last}.", ".$student->{first} %>
									<% $student->{chapter_id} ne $chapter_id ? $student->{name} : "" %>
									<% $student->{entry} ? "(".$student->{entry}.")" : "" %>
								</option>
%							}
						</select>

						</span>

						<span class="padleft padright">
							<input
								type  = "submit"
								class = "thin"
								value = "Go"
								style = "padding-left: 2px; padding-right: 2px;"
							>
						</span>
					</div>

				</form>
%				}

			</div>
%		}

		<& menu.mas,
			person          => $person,
			person_settings => $person_settings,
			school          => $school,
			whoami          => "entry_ratings",
			ajaxify         => "whee",
			prefs           => $prefs,
			category_id     => $category->id,
			entry_id        => $entry_id,
			nodiv           => 1,
			no_others       => $ARGS{no_others},
			dbh             => $ARGS{dbh},
			now             => $ARGS{now},
		&>

	</div>
