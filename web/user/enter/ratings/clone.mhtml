<%args>
	$dbh
	$now
	$session
	$person
	$source_id => undef
	$target_id  => undef
	$style     => undef
</%args>
<%init>

	my $source = Tab::Entry->retrieve($source_id);

	unless ($source) {
		$m->print('<div class="blankfull warning centeralign"><h4>');
		$m->print("No source debater selected.  Please select a debater from whom to copy prefs");
		$m->print('<h4></div>');
		$m->abort;
	}

	my $limit;

	if ($target_id eq int($target_id)) {
		$limit = " and entry.id = ".int($target_id);
	}

	my $sth = $dbh->prepare("
		select entry.id, entry.name, entry.code
			from entry, event
		where entry.school     = ?

			and entry.active   = 1
			and entry.event    = event.id
			and event.category = ?

			and not exists (
				select es.id
				from event_setting es
				where es.event = event.id
				and es.tag = 'no_prefs'
			)
	");

	my $category = $source->event->category;

	$sth->execute($source->school->id, $category->id);
	my $targets = $sth->fetchall_hash();

	unless ($targets && scalar @{$targets}) {
		$m->print('<div class="blankfull warning centeralign"><h4>');
		$m->print("No target debater found.  Please select a debater onto whom to copy prefs from your school.");
		$m->print('</h4></div>');
		$m->abort;
	}

	my @ratings = $source->ratings;

	unless (@ratings) {
		$m->print('<div class="blankfull warning centeralign"><h4>');
		$m->print("You are attempting to copy prefs from someone who doesn't have a prefs.  You probably intended to do that the other way around.  Hit back and try again.");
		$m->print('</h4></div>');
		$m->abort();
	}

	my @results;

	foreach my $target (@{$targets}) {
		my $find_sth = $dbh->prepare("delete from rating where entry = ?");
		$find_sth->execute($target->{id});
	}

	my $count;

	foreach my $rating (@ratings) {

		foreach my $target (@{$targets}) {

			$count++;

			next if $style eq "ordinals" && $rating->rating_tier->id > 0;
			next if $style eq "tiered" && $rating->percentile > 0;

			my $new_rating = $rating->copy({
				entry   => $target->{id},
				entered => $now
			});
		}
	}

	my $msg;

	foreach my $target (@{$targets}) {
		$msg .= "$style Cloned $count Ratings from ".$source->code." to ".$target->{code};
	}

	my $type = $category->setting("prefs");

	$type = "tiered" if $type eq "tiered_round";
	$type = "tiered" if $type eq "caps";
	$type = $style if $style;

	$m->redirect($type."_prefs.mhtml&entry_id=".$source->id."&msg=".$msg);

</%init>

