<%args>
	$person
	$tourn
	$school
	$file_id => undef
</%args>
<%init>

	my $msg;

	if ($file_id) {

		my $reply_form = Tab::File->retrieve($file_id);
		my $filename = $reply_form->filename;

		if ($reply_form && $reply_form->school == $school->id && $filename) {

			system $Tab::s3_cmd." rm ".$Tab::s3_bucket."/tourns/".$tourn->id."/school_form/".$reply_form->parent->id."/".$school->id."/".$filename;

			$msg = "Form ".$filename." has been deleted";

			$m->comp("/funclib/log.mas",
				tag         => "tabbing",
				person      => $person->id,
				tourn       => $tourn->id,
				description => "Form ".$reply_form->label." $filename deleted",
			);

			eval {
				$reply_form->delete();
			};

		} else {

			$m->comp("/funclib/abort.mas",
				message => "No form found with ID $file_id from  your school.  Maybe it was already deleted?"
			);
		}
	}

	$m->redirect("entry.mhtml?school_id=".$school->id."&msg=$msg");

</%init>
