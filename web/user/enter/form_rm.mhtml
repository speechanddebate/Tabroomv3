<%args>
	$person
	$tourn
	$school
	$file_id => undef
</%args>
<%init>

	my $msg;

	if ($file_id) {

		my $reply_form = Tab::File->retrieve($file_id);

		if ($reply_form && $reply_form->school == $school->id) {
			system $Tab::s3_cmd." rm ".$Tab::s3_bucket."/tourns/".$tourn->id."/school_form/".$reply_form->parent->id."/".$school->id."/".$reply_form->filename;
			$msg = "Form ".$reply_form->filename." has been deleted";

			$m->comp("/funclib/form_log.mas",
				person => $person->id,
				tourn  => $tourn->id,
				school => $school->id,
				form   => "School form ".$reply_form->parent->label,
				old    => $reply_form->filename
			);

			$reply_form->delete();
		} else {
			$m->comp("/funclib/abort.mas", message => "No form found with ID $file_id from  your school.  Maybe it was already deleted?");
		}
	}

	$m->redirect("entry.mhtml?school_id=".$school->id."&msg=$msg");

</%init>
