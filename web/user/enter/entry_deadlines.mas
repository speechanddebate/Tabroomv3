<%args>
	$now
	$type => "add"
	$event
	$event_settings
	$tourn
	$tourn_settings
</%args>
<%init>

	my %deadline;

	$deadline{add}     = $event_settings->{deadline} || $tourn->reg_end;
	$deadline{drop}    = $tourn_settings->{drop_deadline} || $deadline{add};
	$deadline{freeze}  = $tourn_settings->{freeze_deadline} || $deadline{drop};
	$deadline{fine}    = $event_settings->{fine_deadline} || $tourn_settings->{fine_deadline};
	$deadline{script}  = $tourn_settings->{script_deadline} || $deadline{add};
	$deadline{release} = $tourn_settings->{release_deadline} || $deadline{add};

	if ($tourn_settings->{"nsda_district"}) {

		my $weekend_id = $event_settings->{"weekend"};

		if ($weekend_id && $weekend_id ne "nope") {

			my $weekend = Tab::Weekend->retrieve($weekend_id);

			$deadline{add}     = $weekend->deadline || $tourn->reg_end;
			$deadline{freeze}  = $weekend->freeze_deadline || $deadline{drop};
			$deadline{drop}    = $weekend->drop_deadline || $deadline{add};
			$deadline{fine}    = $weekend->fine_deadline || $deadline{fine};

			$deadline{script}  = $tourn_settings->{script_deadline} || $deadline{drop};
			$deadline{release} = $tourn_settings->{release_deadline} || $deadline{drop};
		}
	}

	if ($deadline{$type} && $now > $deadline{$type}) {

		if ($type eq "fine" || $type eq "freeze") {
			return 1;
		}

		my $deadline_was = $m->comp("/funclib/showdt.mas",
			dt      => $deadline{$type},
			tz      => $tourn->tz,
			show_tz => 'y',
			format  => 'murica',
			return  => 'y',
		);

		$m->comp("/funclib/abort.mas", 
			message => "The $type deadline for ".$event->abbr." was $deadline_was, and has passed."
		);
	}

	return;
</%init>
