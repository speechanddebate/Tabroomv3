<%args>
	$tourn
	$school_id => undef
	$parent_id => undef
	$label     => undef
</%args>
<%init>

	my $msg;
	my $err;
	my $school = Tab::School->retrieve($school_id);


	if ($ARGS{"file_".$parent_id}) {

		my $req = Apache2::Request->new($r);
		my $upload = $req->upload("file_".$parent_id);

		if ($upload && $upload->filename) {

			my $filename = $m->comp("/funclib/upload_test.mas", upload => $upload);
			$label = $filename unless $label;

			my $filetemp = $upload->tempname;
			my $reply_form;

			# Strip trailing or leading whitespace
			$label =~ s/^\s+//;
			$label =~ s/\s+$//;

			$filename =~ s/^\s+//;
			$filename =~ s/\s+$//;

			my $stored = $m->comp("/funclib/s3_put.mas",
				source => $filetemp,
				key    => "tourns/".$tourn->id."/school_form/".$parent_id."/".$school->id."/".$filename
			);

			if ($stored) {
				$reply_form = Tab::File->create({
					tourn    => $tourn->id,
					school   => $school->id,
					parent   => $parent_id,
					tag      => "form_reply",
					label    => $label,
					filename => $filename,

				});

				$m->comp("/funclib/form_log.mas",
					person => $person->id,
					tourn  => $tourn->id,
					school => $school->id,
					form   => "School form ".$reply_form->parent->label,
					new    => $filename
				);

				$msg = "Form ".$reply_form->filename." uploaded for ".$school->name;

			} else {
				$err .= "Tabroom could not save the file ".$filename." to file storage, so it was not uploaded. Please try again.";
			}
		}
	}

	$err = $err || $msg || "No valid upload processed";

	$m->redirect("entry.mhtml?school_id=".$school->id."&msg=$msg&err=$err");

</%init>
