<%args>
	$school
	$judge_id => undef
</%args>
<%init>

	my $judge = Tab::Judge->retrieve($judge_id) if $judge_id;

	unless ($judge && $judge->school == $school->id) {
		$m->comp("/funclib/abort.mas",
			message => "No judge found with ID ".int($judge_id)." for this school"
		);
	}

	my $tourn = $school->tourn;
	my %tourn_settings = $tourn->all_settings();

	unless ($tourn_settings{"judge_release"}) {
		$m->comp("/funclib/abort.mas",
			message => $tourn->name." does not ask judges for a form"
		);
	}

	my $category = $judge->category;

</%init>

	<div class="main">

		<div class="flexrow ltbluebordertop">
			<span class="half">
				<h4><% $judge->first." ".$judge->last %></h4>
			</span>

			<span class="half rightalign bluetext bigger semibold">
				Judge Form in <% $category->name %>
			</span>
		</div>

		<p>
			The completed judge form for this judge is shown at right. Download
			the blank form, have the judge complete it, and upload the finished
			copy before the deadline.
		</p>

%		if ($tourn_settings{"judge_form_message"}) {
			<div class="padmore">
				<% $tourn_settings{"judge_form_message"} %>
			</div>
%		}

		<a
			class = "buttonwhite bluetext"
			href  = "judges.mhtml?category_id=<% $category->id %>&school_id=<% $school->id %>"
		>Return to <% $category->abbr %> judges</a>

	</div>

	<div class="menu">
		<& "/funclib/judge_release.mas",
			judge          => $judge,
			tourn          => $tourn,
			tourn_settings => \%tourn_settings,
			action         => "judge_release_upload.mhtml",
			hidden         => { school_id => $school->id, from => "form" }
		&>
	</div>
