<%args>
	$dbh
	$now
	$username => undef
	$person   => undef
	$session  => undef
</%args>
<%init>

	use MIME::Lite;

	unless ($username) {
		$m->comp("/funclib/abort.mas",
			message => "You must enter an username or email address to get your login password.  Hit back and try again"
		);
	}

	if ($ENV{HTTP_X_FORWARDED_FOR} ne $ARGS{'origin_ip'}) {
		$m->comp("/funclib/abort.mas",
			message => "Your IP address ".$ENV{HTTP_X_FORWARDED_FOR}." differs from the origin of the requested reset ".$ARGS{'origin_ip'}."  To prevent duplicate requests, your password was not reset.  If this was in error, go back, refresh the page, and try again."
		);
	}

	my $user_person = Tab::Person->search( email => $username )->first;

	if ($user_person)  {

		my $err;
		my $url;
		my $no_change;

		my $nowstring = $m->comp("/funclib/showdt.mas",
			return => 1,
			dt     => $now,
			tz     => "America/Chicago",
			tzname => 'yep'
		);

		# Check the age of any existing password changekey request.  Rate limit
		# to once every 5 minutes.

		my $existing_sth = $dbh->prepare("
			select pck.id, pck.timestamp
				from person_setting pck
			where pck.person = ?
			and pck.tag = 'pass_changekey'
		");

		$existing_sth->execute($user_person->id);
		my $refs = $existing_sth->fetchall_hash();

		if ($refs && scalar @{$refs}) {

			my $ref = shift @{$refs};
			my $age = DateTime::Format::MySQL->parse_datetime($ref->{timestamp});
			$age->add(minutes => 5);

			if ($age > $now) {
				$err = "You may only request a password reset key once every 5 minutes. If the email has not arrived, please check your spam mailbox!";
				$m->redirect("/user/login/forgot.mhtml?err=$err");
			}
		}

		# Generate a hash against the uid
		my $id = $user_person->id;

		# Generate a random authentication string to send to the user
		my $key =  $m->comp("/funclib/generate_randomstring.mas", length => 30);
		my $reset = substr($key, 6);

		my $expires = DateTime->now;
		$expires->add(minutes => '20');

		$user_person->setting("pass_changekey", $key);
		$user_person->setting("pass_change_ip", $ENV{HTTP_X_FORWARDED_FOR});
		$user_person->setting("pass_change_expires", "date", $expires);
		$user_person->setting("pass_change_attempts", 0);

		$url = "$Tab::url_prefix/user/login/forgot_change.mhtml?id=$id&key=$key";

		my $message_text = "
			<p>Someone, hopefully you, has asked to reset your Tabroom.com password.</p>
			<p>Enter this reset key to change your password:</p>
			<h4>".uc($reset)."</h4>
			<p>You may also click on this link, or copy & paste it into your web browser:</p>
			<p><a href='$url'>$url</a></p>
			<p>This reset code and link will expires after 15 minutes.</p>
			<p> If you have any questions, please let us know. </p>
			<p>help\@tabroom.com</p>
			<br />
			<br />
			<p>Requestor IP: ".$ENV{HTTP_X_FORWARDED_FOR}."</p>
			<p>Timestamp: $nowstring</p>
		";

		my @ids;
		push @ids, $user_person->id;

		my $numberwang = substr($now->epoch, -6, 6);
		my $from_string = "Tabroom Password Reset <iforgot_".$numberwang.'@www.tabroom.com>';

		$m->comp("/funclib/send_notify.mas",
			from            => $from_string,
			ids             => \@ids,
			ignore_no_email => 1,
			no_inbox        => 1,
			no_web          => 1,
			subject         => 'Your Tabroom.com Password Reset',
			html            => $message_text
		);

		my $logmsg = "Password change link requested for user ".$user_person->id." ".$user_person->email." from IP: ".$ENV{HTTP_X_FORWARDED_FOR};

		if ($ARGS{"session"}) {
			$logmsg .= "User session ".$ARGS{"session"}." user ".$ARGS{"session"}->person->id." SU ".$ARGS{"session"}->su;
		}

		Tab::log($logmsg);
		$m->redirect("forgot_change.mhtml?id=".$user_person->id);
	}

	sleep 10;
	my $err = "No such user";
	$m->redirect("forgot.mhtml?err=$err");


</%init>
