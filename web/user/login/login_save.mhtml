<%args>
	$now
	$dbh
	$person   => undef
	$session  => undef
	$username => undef
	$password => undef
	$url      => undef
	$salt     => undef
	$sha      => undef
</%args>
<%init>

	my $log;
	my $err;
	my $sha_user;
	my $ip = $ENV{"HTTP_X_FORWARDED_FOR"} || $ENV{REMOTE_ADDR};

	if ($session || $person) {
		$person = $session->person unless $person;
		my $err = " You are already logged in as ".$person->email;
		$m->redirect("/user/home.mhtml?err=$err");
	}

	my $log_failure = $dbh->prepare("insert into login_log (description, username, ip) values (?, ?, ?)");

	unless ($username) {
		my $err = "You must enter an email address or username.  Please try again.";
		Tab::log("Failed: no username entered. $log");
		$log_failure->execute("No username entered. $log", $username, $ip);
		$m->redirect("/user/login/login.mhtml?username=$username&err=$err");
	}

	my $key = $ip.$now->day_of_year.$now->hour.$Tab::string;
	my $sha_check = crypt($key, '$6$'.$salt);

	my $user_person = Tab::Person->search(email => $username)->first;

	unless ($sha_check eq $sha) {

		my $hour = $now->hour;
		$hour--;
		$hour = 23 if $hour < 0;

		$key = $ip.$now->day_of_year.$hour.$Tab::string.
		$sha_check = crypt($key, '$6$'.$salt);

		unless ($sha_check eq $sha) {

			Tab::log("KEYLESS LOGIN ATTEMPT: ".$username." from ".$ip);

			# The dumbest form of rate limiting in the world.  But decently effective.
			sleep 5;

			$m->comp("/user/login/login.mhtml",
				message => "Your request did not originate from Tabroom, or came from a stale page.  Please try again."
			);
		}
	}

	if ($ip ne "127.0.0.1"
		&& (index ($ip, "172.18") == -1)
		&& (index ($ip, "172.17") == -1)
		&& (index ($ip, "10.19.25") == -1)
	) {

		my $check_ip_bans = $dbh->prepare("
			select login.id
				from login_log login
			where login.description = 'banned'
				and login.created_at > (NOW() - INTERVAL 10 MINUTE)
				and login.ip = ?
				and login.revoked != 1
		");

		$check_ip_bans->execute($ip, $username);
		my ($bans) = $check_ip_bans->fetch();

		if ($bans) {
			my $err = "Because of multiple failed attempts, logins for $username from $ip have been temporarily banned.  Please try again after 10 minutes.";
			Tab::log("Failed Attempt Ban Issued for $ip");
			$m->redirect("/user/login/login.mhtml?username=$username&err=$err");
		}

		my $ip_failure_rate_limit = $dbh->prepare("
			select count(distinct login.id) count
				from login_log login
			where login.created_at > (NOW() - INTERVAL 5 MINUTE)
				and login.ip = ?
				and login.revoked != 1
		");

		$ip_failure_rate_limit->execute($ip);
		my ($ip_limit) = $ip_failure_rate_limit->fetch();

		if ($ip_limit > 32) {
			my $err = "There have been too many failed login attempts from $ip.  Please wait a few minutes before trying again.";
			Tab::log("Failed Attempt Ban Issued for $ip");
			my $ban_ip = $dbh->prepare("insert into login_log (description, ip) values ('banned', ?)");
			$ban_ip->execute($ip);
			$m->redirect("/user/login/login.mhtml?username=$username&err=$err");
		}
	}

	my $check_username_ban = $dbh->prepare("
		select login.id
			from login_log login
		where login.description = 'banned'
			and login.created_at > (NOW() - INTERVAL 10 MINUTE)
			and login.username = ?
			and login.revoked != 1
	");

	$check_username_ban->execute($username);
	my ($bans) = $check_username_ban->fetch();

	if ($bans) {
		my $err = "Because of multiple failed attempts, logins for $username have been temporarily banned.  Please try again after 10 minutes.";
		Tab::log("Failed Attempt Ban Issued for $ip");
		$m->redirect("/user/login/login.mhtml?username=$username&err=$err");
	}

	my $username_failure_rate_limit = $dbh->prepare("
		select count(distinct login.id) count
		from login_log login
		where login.created_at > (NOW() - INTERVAL 5 MINUTE)
			and login.username = ?
			and login.revoked != 1
	");

	$username_failure_rate_limit->execute($username);
	my ($username_limit) = $username_failure_rate_limit->fetch();

	if ($username_limit > 10) {

		my $user_ban = $dbh->prepare("insert into login_log (description, username) values ('banned', ?)");
		$user_ban->execute($username);

		if ($user_person) {

			Tab::log("Failed Attempts. Ten minute ban issued for $username.  User $user_person notified.");

			my $url = "$Tab::url_prefix/user/login/forgot.mhtml";
			my $message_text = "

				<p>
					Someone, hopefully you, has been attempting to log in to
					your Tabroom account, and has failed $username_limit times
					in the last 5 minutes.
				</p>

				<p>
					That access has been throttled for a few minutes to prevent
					bot activity.</p>

				<p>
					If this was not you, consider changing your password; log
					into Tabroom and click the Person icon on the top right
					corner. If this problem persists, contact us at
					help\@tabroom.com.
				</p>

				<p>
					If you have any questions, please let us know.
				</p>

				<p>Thank you,</p>

				<p>Tabroom.com</p>
				<p>at the National Speech & Debate Association</p>
				<p>help\@tabroom.com</p>
				<p></p>
				<p></p>
				<p>Requestor IP: ".$ip."</p>
				<p>Timestamp: $now</p>
			";

			my @ids;
			push @ids, $user_person->id;

			my $numberwang = substr($now->epoch, -6, 6);
			my $from_string = "Tabroom Accounts <account_".$numberwang.'@www.tabroom.com>';

			$m->comp("/funclib/send_notify.mas",
				from            => $from_string,
				ids             => \@ids,
				ignore_no_email => 1,
				no_inbox        => 1,
				no_web          => 1,
				subject         => 'Your Tabroom.com Password Reset',
				html            => $message_text
			);

			Tab::log("$username has had too many failed attempts. A temporary ban has been issued for $username. See your email for more details.");
		} else {
			Tab::log("Too many failed attempts. Ban issued for $username, which does not exist.");
		}

		sleep 5;

		$err = "$username has had too many failed attempts. A temporary ban has been issued for $username. See your email for more details.";
		$m->redirect("/user/login/login.mhtml?username=$username&err=$err");
	}

	$log .= " Login attempt by ".$username." from ".$ip." ....";
	$username =~ tr/[A-Z]/[a-z]/;
	$username =~ s/\s+//g;
	$password =~ s/\s+$//g;  #only you can prevent trailing whitespace.

	unless ($password) {
		my $err = "You must enter a password.  Please try again.";
		Tab::log("Failed: blank password.  $log");
		$log_failure->execute("Blank password", $username, $ip);
		$m->redirect("/user/login/login.mhtml?username=$username&err=$err");
	}

	unless ($user_person) {
		my $err = "Your email and/or password was not correct.  Please try again, ";
		$err .= "or use the Forgot Password link to refresh your password";
		$log_failure->execute("No such person for username $username", $username, $ip);
		Tab::log("Failed: no such person. $log");
		$m->redirect("/user/login/login.mhtml?err=$err");
	}

	if ($user_person->setting("banned")) {
		my $err = "You are not permitted access to Tabroom";
		$log_failure->execute("Banned account $user_person", $username, $ip);
		Tab::log("REVOKED USER LOGIN: $log");
		$m->redirect("/user/login/login.mhtml?username=$username&err=$err");
	}

	my $db_sha_crypt = $user_person->password;
	my $sha_crypt = crypt($password, $db_sha_crypt) if $db_sha_crypt;
	my $pass_ok;

	if ($sha_crypt && ($sha_crypt eq $db_sha_crypt)) {
		$pass_ok++;
	}

	if ($pass_ok) {

		# To maintain state, the cookie sha keys are encoded using a random
		# string set by the site.

		my $new_session = Tab::Session->create( {
			person     => $user_person->id,
			ip         => $ip,
		});

		$salt = $m->comp("/funclib/generate_randomstring.mas");
		$sha_user = crypt($new_session->id.$Tab::string, '$6$'.$salt);
		$new_session->userkey($sha_user);
		$new_session->update();

		# I'm getting tired of random lock condition emails that Perl does
		# not handle so this is me pressing the "fuck it make it work and
		# shut up" button.

		eval {
			$user_person->setting("last_login_ip", $ip);
			$user_person->setting("last_login_ip", $ip);
		};

	} else {

		my $err = "Your login and/or password was not correct.  Please try again, or use the Forgot Password link to reset your password";

		eval {
			$user_person->setting("last_attempt", "date", $now);
			$user_person->setting("last_attempt_ip", $ip);
			$user_person->setting("last_attempt_agent", $ENV{HTTP_USER_AGENT});
		};

		$log_failure->execute("Wrong password for person ID $user_person", $username, $ip);
		Tab::log("Failed: wrong password. $log.  Attempt from $ip");
		sleep 5;
		$m->redirect("/user/login/login.mhtml?username=$username&err=$err");
	}

	# let ppl use their computer & phone, but not share their access with the world...
	my $allowed_sessions = 3;

	# Admins need a few more:
	$allowed_sessions = 6 if $user_person->site_admin;

	# If you know enough to change this code go ahead and add yourself for more
	# login sessions.

	$allowed_sessions = 10 if $user_person->id == 1;
	$allowed_sessions = 5 if $user_person->id == 509488;
	$allowed_sessions = 5 if $user_person->id == 489476;
	$allowed_sessions = 5 if $user_person->id == 21147;
	$allowed_sessions = 5 if $user_person->id == 381364;

	foreach my $sess ( sort {$b->id <=> $a->id} $user_person->sessions) {
		$sess->delete() unless $allowed_sessions;
		$allowed_sessions--;
	}

	my $result;
	my $method = substr($Tab::url_prefix, 0, 5);

	my $secure = 0;
	if ($method eq "https") {
		$secure = 1;
	}

	#Clear out some older stuff that may interfere
	my $tokencookie = Apache2::Cookie->new(
		$r,
		-name     => $Tab::cookie_name || 'TabroomToken',
		-value    => $sha_user,
		-expires  => '+1024h',
		-domain   => $Tab::cookie_domain,
		-secure   => $secure,
		-httponly => 1,
		-path     => '/'
	);

	$tokencookie->bake($r);

	$log .= " ...Succeeded!";
	Tab::log("$log");

	$user_person->accesses($user_person->accesses + 1);
	$user_person->last_access($now);
	$user_person->update();

	if ($ARGS{"return"} eq "singups" || $ARGS{"return"} eq "judgesign") {
		$m->redirect("/index/tourn/judge_signups.mhtml?category_id=".$ARGS{"category_id"}."&tourn_id=".$ARGS{"tourn_id"}."&cat_key=".$ARGS{'cat_key'});
	}

	if ($ARGS{"return"}) {
		return 1;
	}

    $m->redirect("https://$url") if $url;
    $m->redirect("/index/tourn/main.mhtml?tourn_id=$ARGS{tourn_id}") if $ARGS{tourn_id} && $ARGS{index};
    $m->redirect("/index/register.mhtml?tourn_id=$ARGS{tourn_id}") if $ARGS{tourn_id};
    $m->redirect("/user/home.mhtml");

</%init>
