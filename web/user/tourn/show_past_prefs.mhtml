<%args>
	$dbh
	$now
	$person
	$tourn
	$judge_person_id => undef
</%args>
<%init>

	unless ($judge_person_id) {
		$m->comp("/funclib/abort.mas", message => "No valid judge found");
	}

	#find the chapter for this person at this tourney
	my $judge_person = Tab::Person->retrieve($judge_person_id);

	unless ($judge_person) {
		$m->comp("/funclib/abort.mas", message => "No valid judge found");
	}

	my $past_prefs_sth = $dbh->prepare("
		select rating.*,
			entry.name as entry_name,
			chapter.name as chapter_name
			(select rating_tier.name
				from rating_tier
				where rating_tier.id = rating.rating_tier
			) as rating_tier,
			tourn.name tourn_name
		from rating, entry, school, judge, chapter, permission, tourn
		where rating.entry = entry.id
			and entry.school   = school.id
			and rating.judge   = judge.id
			and judge.person   = ?
			and school.chapter = chapter.id
			and school.tourn = tourn.id
			and chapter.id = permission.chapter
			and permission.person = ?
			and permission.tag IN ('prefs', 'chapter')
			and tourn.end < NOW()
	");

	$past_prefs_sth->execute($judge_person->id, $person->id);
	my $past_prefs = $past_prefs_sth->fetchall_hash();

</%init>

	<div class="main">

		<& "/funclib/tablesorter.mas", table => "ordinals" &>

		<h4>Your past ratings for <% $judge_person->first." ".$judge_person->last %></h4>

		<table id="ordinals">

			<thead>

			<tr class="yellowrow">

				<th>
					Tourney
				</th>
				<th>
					Entry
				</th>
				<th>
					Tier
				</th>
				<th>
					Ordinal
				</th>
				<th>
					Percentile
				</th>

			</tr>

			</thead>

			<tbody>

%			foreach my $rating (@{$past_prefs}) {

				<tr class="row">
					<td class="last smallish padless">
						<% $rating->{tourn_name} %>
					</td>
					<td class="last smallish padless">
						<% $rating->{entry_name} %>
					</td>
					<td class="last smallish padless">
						<% $rating->{rating_tier} %>
					</td>
					<td class="last smallish padless">
						<% $rating->{ordinal} %>
					</td>
					<td class="last smallish padless">
						<% $rating->{percentile} %>
					</td>
				</tr>

%			}

		</tbody>

	</table>

	</div>

    <div class="menu">

		<div class="sidenote">

			<h4>Return</h4>

			<a class="blue block" href="/index/paradigm.mhtml?judge_person_id=<% $judge_person_id %>">
				Back to Judge Paradigm
			</a>

		</div>

	</div>
