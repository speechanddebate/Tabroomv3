<%args>
	$api_key        => undef
	$api_id         => undef
	$tourn_id       => undef
</%args>
<%init>

    $m->clear_buffer();
    $r->content_type('application/json');

	my ($person, $tourn) = $m->comp("login_api.mas",
		method    => "api_key",
		person_id => $api_id,
		api_key   => $api_key,
		tourn_id  => $tourn_id,
	);

	unless ($person && $tourn) {

		my %output = (
			error => \1,
			message => 'No valid API user or key sent'
		);

		$m->print(JSON::encode_json(\%output));
		$m->abort();
	}

	my $dbh = Tab::DBI->db_Main();

	my $sth = $dbh->prepare("
		select school.id, school.name,
			school.state, chapter.state cstate,
			chapter.country,

			CONCAT(contact.first,' ',contact.last) contact_name,
			contact.email contact_email,
			contact.phone contact_phone,

		from school
			left join chapter on chapter.id = school.chapter
			left join contact sc on sc.school = school.id and sc.official = 1
			left join person contact on contact.id = sc.person
		where school.tourn = ?

		and exists (
			select entry.id
			from entry
			where entry.school = school.id
		)
	");

	$sth->execute($tourn->id);

	my @output;

	while (
		my (
			$id, $name, $state, $cstate, $country,
			$contact, $email, $number
		) = $sth->fetchrow_array()
	) {

		if ($school{$id}) {

			push @{$school->{contacts}}, {
				name => $contact,
				email => $email,
				phone => $number
			};

		} else {

			my @contacts = ();

			push @contacts, {
				name => $contact,
				email => $email,
				phone => $number
			};

			my %school = (
				"id"       => $id,
				"name"     => $name,
				"state"    => $state || $cstate,
				"country"  => $country,
				"contacts" => \@contacts
			);
		}

		push @output, \%school;
	}

	$m->print(JSON::encode_json(\@output));
	$m->abort();

</%init>

