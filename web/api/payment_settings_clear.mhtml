<%args>
	$person   => undef
	$session  => undef
</%args>
<%init>

	unless ($person && $session && $session->id > 0) {
		$m->comp("local_only.mas");
	}
	my $dbh = Tab::DBI->db_Main();

	my $sth = $dbh->prepare("
		DELETE TS FROM tourn_setting TS
		INNER JOIN tourn T ON T.id = TS.tourn
		WHERE
			T.end < NOW()
			AND (TS.tag LIKE '%authorizenet%' OR TS.tag LIKE '%paypal%')
	");

	$sth->execute();

</%init>
